{
  "version": "0.2",
  "packages": {
    "frontend": {
      "allowed_dependencies": [
        "ai"
      ]
    },
    "ai": {
      "allowed_dependencies": []
    },
    "backend": {
      "allowed_dependencies": []
    }
  },
  "pure_package": "ai",
  "python_forbidden_imports": [
    "requests",
    "httpx",
    "socket",
    "subprocess",
    "urllib.request",
    "pathlib"
  ],
  "python_forbidden_calls": [
    "open"
  ],
  "js_forbidden_calls": [
    "fetch",
    "WebSocket",
    "XMLHttpRequest"
  ],
  "js_forbidden_objects": [
    "document",
    "localStorage",
    "sessionStorage"
  ],
  "source_extensions": [
    ".py",
    ".js",
    ".jsx",
    ".ts",
    ".tsx"
  ],
  "limitations": "명시적 import·직접 I/O 정적 검사. 실제 스택의 별칭·동적 로딩·전체 부작용은 별도 검사 필요",
  "js_forbidden_imports": [
    "fs",
    "node:fs",
    "node:fs/promises",
    "http",
    "https",
    "node:http",
    "node:https",
    "axios",
    "child_process",
    "node:child_process"
  ]
}
